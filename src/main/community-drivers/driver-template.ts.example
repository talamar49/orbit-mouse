import type { DeviceSettings, DeviceSnapshot } from '../../shared/device'
import type { CapturedControl, DeviceAdapter } from '../hardware/adapter'
import { defineCommunityDriver, ORBIT_DRIVER_API_VERSION } from '../hardware/communitySdk'

class ExampleAdapter implements DeviceAdapter {
  readonly id = 'community.your-name.your-device'
  readonly name = 'Your Logitech device'
  readonly deviceKinds = ['mouse'] as const
  readonly supportedModels = ['Your model'] as const
  readonly actionDefinitions = [
    {
      id: 'community.your-name.your-device.example-action',
      label: 'Example device action',
      detail: 'Describe what the hardware will do',
      category: 'Your device'
    }
  ] as const

  constructor(private readonly emitControl: (control: CapturedControl) => void) {}

  async discover(): Promise<DeviceSnapshot[]> {
    // Find only verified vendor/product IDs. Return real telemetry or null.
    return []
  }

  async saveSettings(_deviceId: string, _settings: DeviceSettings): Promise<void> {
    // Apply only settings advertised by the snapshot's settingsSections.
  }

  async runAction(_deviceId: string, actionId: string): Promise<void> {
    if (actionId !== this.actionDefinitions[0].id) throw new Error('Unknown driver action.')
    // Perform the device-specific operation here.
  }

  // Call this from the transport when a diverted control changes state.
  protected control(controlId: string, cid: number, phase: 'down' | 'up'): void {
    this.emitControl({ controlId, cid, phase })
  }
}

export default defineCommunityDriver({
  apiVersion: ORBIT_DRIVER_API_VERSION,
  id: 'community.your-name.your-device',
  name: 'Your Logitech device',
  supportedModels: ['Your model'],
  deviceKinds: ['mouse'],
  create: ({ emitControl }) => new ExampleAdapter(emitControl)
})
